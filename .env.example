# پورت اجرا (روی Railway به صورت خودکار ست میشه، نیازی به تغییر نیست)
PORT=3000

# کلید رمزنگاری سشن - یک رشته تصادفی و طولانی اینجا بذار
SESSION_SECRET=change-this-to-a-very-long-random-secret-string

# مسیر ذخیره‌سازی دیتابیس و فایل‌های آپلودی
# روی Railway پیشنهاد میشه یک Volume به این مسیر وصل کنی تا اطلاعات با هر دیپلوی پاک نشه
DATA_DIR=./data

# اطلاعات کارت به کارت که به مشتری نمایش داده میشه
# نکته: این مقدار فقط بار اول (وقتی دیتابیس خالیه) به عنوان پیش‌فرض استفاده میشه.
# بعد از اولین اجرا، شماره کارت رو از پنل مدیریت > تنظیمات هر وقت خواستی تغییر بده (نیازی به دیپلوی دوباره نیست).
CARD_NUMBER=6219861353415861
CARD_HOLDER=نام صاحب کارت
CARD_BANK=بانک سامان

# اطلاعات ادمین اولیه (فقط بار اول که سرور بالا میاد ساخته میشه)
ADMIN_NAME=مدیر فروشگاه
ADMIN_USERNAME=admin
ADMIN_PHONE=09120000000
ADMIN_PASSWORD=change-this-admin-password

# رمز ورود سریع به پنل ادمین (آدرس /aurevonfilter) - فقط همین رمز لازمه، نیازی به یوزرنیم نیست
# حتما این رو به یک رمز قوی و شخصی تغییر بده
ADMIN_PANEL_PASSWORD=change-me-please

# نام فروشگاه
SHOP_NAME=AurevonFilter

# درگاه پرداخت آینده (cartbecart.ir) - فعلا خالی بذار، بعدا تکمیل میشه
PAYMENT_GATEWAY_ENABLED=false
CARTBECART_MERCHANT_ID=
CARTBECART_API_KEY=
