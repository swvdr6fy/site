<%- include('../partials/header') %>

<h1 class="page-title" style="margin-bottom:20px;">مدیریت دسته‌بندی‌ها</h1>
<%- include('_tabs', { active: 'categories' }) %>

<% if (error) { %><div class="flash flash-error"><%= error %></div><% } %>

<form action="/admin/categories" method="POST" style="display:flex; gap:10px; margin-bottom:24px; max-width:420px;">
  <input type="text" name="name" placeholder="نام دسته‌بندی جدید" required style="flex:1; padding:11px 14px; border-radius:10px; border:1px solid var(--card-border); background:var(--bg-soft); color:var(--text); font-family:inherit;">
  <button type="submit" class="btn btn-primary">افزودن</button>
</form>

<div class="table-wrap">
  <table class="data-table">
    <thead><tr><th>نام</th><th>اسلاگ</th><th></th></tr></thead>
    <tbody>
      <% categories.forEach(c => { %>
        <tr>
          <td><%= c.name %></td>
          <td><%= c.slug %></td>
          <td>
            <form action="/admin/categories/<%= c.id %>/delete" method="POST" onsubmit="return confirm('حذف این دسته‌بندی؟ محصولات آن بدون دسته‌بندی می‌شوند.');">
              <button type="submit" class="btn btn-danger btn-sm">حذف</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
