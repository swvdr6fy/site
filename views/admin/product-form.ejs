<%- include('../partials/header') %>

<h1 class="page-title" style="margin-bottom:20px;"><%= product ? 'ویرایش محصول' : 'افزودن محصول جدید' %></h1>
<%- include('_tabs', { active: 'products' }) %>

<% if (error) { %><div class="flash flash-error"><svg class="icon"><use href="#i-alert"/></svg> <%= error %></div><% } %>

<div class="admin-form-grid">
  <div class="form-card" style="max-width:none;">
    <form action="<%= product ? '/admin/products/' + product.id + '/edit' : '/admin/products/new' %>" method="POST" enctype="multipart/form-data" id="productForm">
      <div class="form-group">
        <label>عنوان محصول</label>
        <input type="text" name="title" id="f-title" required value="<%= product ? product.title : '' %>">
      </div>
      <div class="form-group">
        <label>توضیحات</label>
        <textarea name="description"><%= product ? product.description : '' %></textarea>
      </div>
      <div class="form-group">
        <label>دسته‌بندی</label>
        <select name="category_id" id="f-category">
          <option value="">بدون دسته‌بندی</option>
          <% categories.forEach(c => { %>
            <option value="<%= c.id %>" data-name="<%= c.name %>" <%= product && product.category_id === c.id ? 'selected' : '' %>><%= c.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label>تصویر محصول (اختیاری - در صورت خالی بودن، پوستر به‌صورت خودکار ساخته می‌شود)</label>
        <input type="file" name="image" accept="image/*">
        <% if (product && product.image) { %>
          <img src="/uploads/products/<%= product.image %>" style="width:70px;height:70px;object-fit:cover;border-radius:8px;margin-top:8px;">
        <% } %>
      </div>

      <h2 class="section-title" style="margin-top:24px;"><svg class="icon"><use href="#i-tag"/></svg> پلن‌ها / حجم‌ها (اختیاری)</h2>
      <p class="form-hint" style="margin-bottom:12px;">مثلا برای VPN: 30 گیگابایت، 60 گیگابایت و ... - هرکدوم با قیمت جدا. اگه پر نکنی، محصول با قیمت و موجودی ساده زیر ذخیره میشه.</p>

      <div id="variantRows">
        <% variants.forEach(v => { %>
          <div class="variant-row">
            <input type="text" name="variant_label[]" placeholder="عنوان پلن (مثلا: 30 گیگابایت - 1 ماهه)" value="<%= v.label %>">
            <input type="number" name="variant_price[]" placeholder="قیمت" value="<%= v.price %>">
            <input type="number" name="variant_stock[]" placeholder="موجودی" value="<%= v.stock %>">
            <button type="button" class="variant-remove-btn" onclick="this.parentElement.remove()">حذف</button>
          </div>
        <% }) %>
      </div>
      <button type="button" class="btn btn-outline btn-sm" onclick="addVariantRow()" style="margin-bottom:20px;"><svg class="icon"><use href="#i-plus"/></svg> افزودن پلن</button>

      <h2 class="section-title">قیمت و موجودی ساده (در صورت نداشتن پلن)</h2>
      <div class="form-group">
        <label>قیمت پایه (تومان)</label>
        <input type="number" name="price" id="f-price" min="0" value="<%= product ? product.price : '' %>">
      </div>
      <div class="form-group">
        <label>موجودی</label>
        <input type="number" name="stock" min="0" value="<%= product ? product.stock : '0' %>">
      </div>

      <div class="form-group toggle-row">
        <label class="toggle-switch">
          <input type="checkbox" name="is_active" id="is_active" <%= (!product || product.is_active) ? 'checked' : '' %>>
          <span class="track"></span><span class="thumb"></span>
        </label>
        <label for="is_active" style="margin:0;">محصول فعال باشد (در فروشگاه نمایش داده شود)</label>
      </div>
      <div class="form-group toggle-row">
        <label class="toggle-switch">
          <input type="checkbox" name="is_featured" id="f-featured" <%= (product && product.is_featured) ? 'checked' : '' %>>
          <span class="track"></span><span class="thumb"></span>
        </label>
        <label for="f-featured" style="margin:0;">پلن ویژه باشد (نشان «ویژه» + پوستر اختصاصی مجنتا)</label>
      </div>
      <button type="submit" class="btn btn-primary btn-block"><%= product ? 'ذخیره تغییرات' : 'افزودن محصول' %></button>
    </form>
  </div>

  <div class="admin-preview-wrap">
    <div class="admin-preview-label"><svg class="icon"><use href="#i-box"/></svg> پیش‌نمایش زنده پوستر محصول</div>
    <div class="poster poster-v1" id="posterPreview">
      <div class="poster-glow poster-glow-1"></div>
      <div class="poster-glow poster-glow-2"></div>
      <div class="poster-grid"></div>
      <div class="poster-top">
        <span class="poster-brand"><span class="logo-mark small">A</span> AUREVON</span>
        <span id="previewFeaturedBadge" style="display:none;" class="p-badge p-badge-featured"><svg class="icon"><use href="#i-bolt"/></svg> ویژه</span>
      </div>
      <div class="poster-mid">
        <div class="poster-icon"><svg class="icon"><use href="#i-shield"/></svg></div>
        <div class="poster-volume" id="previewTitle"><%= product ? product.title : 'عنوان محصول' %></div>
        <div class="poster-plan-label" id="previewCategory">دسته‌بندی</div>
      </div>
      <div class="poster-bottom">
        <span>PREMIUM • SECURE</span>
        <span id="previewPrice"><%= product && product.price ? Number(product.price).toLocaleString('fa-IR') + ' تومان' : '—' %></span>
      </div>
    </div>
    <p class="form-hint" style="text-align:center; margin-top:10px;">این پیش‌نمایش تقریبی است؛ در صورت خالی گذاشتن تصویر، پوستر نهایی هنگام ذخیره به‌صورت خودکار روی سرور ساخته می‌شود.</p>
  </div>
</div>

<script>
function addVariantRow() {
  const wrap = document.getElementById('variantRows');
  const row = document.createElement('div');
  row.className = 'variant-row';
  row.innerHTML = `
    <input type="text" name="variant_label[]" placeholder="عنوان پلن (مثلا: 30 گیگابایت - 1 ماهه)">
    <input type="number" name="variant_price[]" placeholder="قیمت">
    <input type="number" name="variant_stock[]" placeholder="موجودی">
    <button type="button" class="variant-remove-btn" onclick="this.parentElement.remove()">حذف</button>
  `;
  wrap.appendChild(row);
}

// --- پیش‌نمایش زنده پوستر ---
(function () {
  const titleInput = document.getElementById('f-title');
  const priceInput = document.getElementById('f-price');
  const categorySelect = document.getElementById('f-category');
  const featuredCheck = document.getElementById('f-featured');
  const poster = document.getElementById('posterPreview');
  const previewTitle = document.getElementById('previewTitle');
  const previewCategory = document.getElementById('previewCategory');
  const previewPrice = document.getElementById('previewPrice');
  const previewBadge = document.getElementById('previewFeaturedBadge');
  const variants = ['poster-v1', 'poster-v2', 'poster-v3', 'poster-v4', 'poster-v5', 'poster-v6'];

  function hash(str) {
    let h = 0;
    for (let i = 0; i < str.length; i++) { h = (h << 5) - h + str.charCodeAt(i); h |= 0; }
    return Math.abs(h);
  }

  function update() {
    const title = titleInput.value.trim() || 'عنوان محصول';
    previewTitle.textContent = title;
    const catOpt = categorySelect.options[categorySelect.selectedIndex];
    previewCategory.textContent = (catOpt && catOpt.getAttribute('data-name')) || 'PREMIUM';
    const price = parseInt(priceInput.value, 10);
    previewPrice.textContent = price ? price.toLocaleString('fa-IR') + ' تومان' : '—';

    variants.forEach((v) => poster.classList.remove(v));
    if (featuredCheck.checked) {
      poster.classList.add('poster-v5');
      previewBadge.style.display = 'inline-flex';
    } else {
      poster.classList.add(variants[hash(title) % 4]);
      previewBadge.style.display = 'none';
    }
  }

  [titleInput, priceInput, categorySelect, featuredCheck].forEach((el) => {
    el.addEventListener('input', update);
    el.addEventListener('change', update);
  });
  update();
})();
</script>

<%- include('../partials/footer') %>
