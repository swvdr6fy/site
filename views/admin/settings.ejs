<%- include('../partials/header') %>

<h1 class="page-title" style="margin-bottom:20px;">تنظیمات فروشگاه</h1>
<%- include('_tabs', { active: 'settings' }) %>

<form action="/admin/settings" method="POST" enctype="multipart/form-data" class="form-card" style="max-width:600px;">

  <h2 class="section-title" style="margin-top:0;"><svg class="icon"><use href="#i-box"/></svg> پوستر صفحه اصلی</h2>
  <div class="form-group">
    <label>عنوان بزرگ پوستر</label>
    <input type="text" name="banner_title" value="<%= settings.banner_title %>">
  </div>
  <div class="form-group">
    <label>متن توضیح پوستر</label>
    <textarea name="banner_subtitle"><%= settings.banner_subtitle %></textarea>
  </div>
  <div class="form-group">
    <label>متن قیمت (مثلا: شروع قیمت از ۱۵۰,۰۰۰ تومان)</label>
    <input type="text" name="banner_price_text" value="<%= settings.banner_price_text %>">
  </div>
  <div class="form-group">
    <label>تصویر پس‌زمینه پوستر (اختیاری)</label>
    <input type="file" name="banner_image_file" accept="image/*">
    <% if (settings.banner_image) { %>
      <img src="/uploads/banners/<%= settings.banner_image %>" class="banner-preview">
    <% } %>
  </div>

  <h2 class="section-title"><svg class="icon"><use href="#i-lock"/></svg> اطلاعات کارت به کارت</h2>
  <div class="form-group">
    <label>شماره کارت</label>
    <input type="text" name="card_number" value="<%= settings.card_number %>" dir="ltr" style="text-align:center;">
  </div>
  <div class="form-group">
    <label>نام صاحب کارت</label>
    <input type="text" name="card_holder" value="<%= settings.card_holder %>">
  </div>
  <div class="form-group">
    <label>نام بانک (اختیاری)</label>
    <input type="text" name="card_bank" value="<%= settings.card_bank %>">
  </div>

  <button type="submit" class="btn btn-primary btn-block">ذخیره تنظیمات</button>
</form>

<%- include('../partials/footer') %>
