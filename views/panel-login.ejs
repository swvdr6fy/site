<%- include('partials/header') %>

<div class="auth-wrap">
  <div class="form-card glass-card reveal">
    <div class="form-title">ورود به پنل ادمین</div>
    <div class="form-sub">رمز پنل ادمین را وارد کنید.</div>

    <% if (error) { %><div class="flash flash-error"><%= error %></div><% } %>

    <form action="/aurevonfilter" method="POST">
      <div class="form-group">
        <label>رمز پنل</label>
        <input type="password" name="password" required autofocus>
      </div>
      <button type="submit" class="btn btn-primary btn-block">ورود به پنل</button>
    </form>
  </div>
</div>

<%- include('partials/footer') %>
